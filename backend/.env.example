# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://resonance:resonance@localhost:5432/resonance?schema=public"

# Development-only session fallback when PostgreSQL is unavailable. Set false in production.
RES_DEMO_MODE=true
RES_SESSION_TTL_SECONDS=86400
RES_SESSION_COOKIE=resonance_session
RES_RATE_LIMIT_PER_MINUTE=120

# CORS / browser integration
FRONTEND_URL="http://localhost:3000"
RES_ALLOWED_ORIGINS="http://localhost:3000"

# Phase 3 protocol integration. The demo adapter remains the default; set SOLANA_PROTOCOL_ADAPTER=solana only when a wallet-signed client flow is wired.
SOLANA_PROTOCOL_ADAPTER="demo"
SOLANA_NETWORK="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_PROGRAM_ID="Cp1QZyTidu8ZFj5tcYNEw2Z7fJTBmAR6gA8vnzQHNKbT"
SOLANA_COMMITMENT="confirmed"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_PROGRAM_ID="Cp1QZyTidu8ZFj5tcYNEw2Z7fJTBmAR6gA8vnzQHNKbT"

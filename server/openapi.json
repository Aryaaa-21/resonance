    "/api/events/{id}/attestations": {
      "post": {
        "summary": "Prepare a demo attestation or unsigned wallet-signed Solana transaction",
        "responses": {
          "201": {
            "description": "Simulation-only attestation"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "503": {
            "description": "Database unavailable"
          }
        },
        "tags": [
          "events"
        ],
        "description": "mode=demo returns an explicit simulation. mode=solana builds an unsigned transaction; the caller must sign and submit it, then call /api/attestations/sync."
      }
    },
    "/api/attestations/sync": {
      "post": {
        "summary": "Sync a wallet-submitted protocol transaction",
        "description": "Records chain metadata only from a transaction signature and RPC status; does not invent signatures or claim success when the chain reports an error.",
        "tags": [
          "attestations"
        ],
        "responses": {
          "200": {
            "description": "Synchronized chain status"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Attestation not found"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "503": {
            "description": "Database or RPC unavailable"
          }
        }
      }
    },
    "/api/attestations/{id}/verify": {
      "get": {
        "summary": "Independently verify an attestation integrity receipt",
        "description": "Recomputes canonical evidence and observation commitments, verifies the witness signature, checks the anchored Solana transaction envelope when present, and reports tamper detection. This does not prove real-world truth.",
        "responses": {
          "200": {
            "description": "Independent verification result"
          },
          "404": {
            "description": "Attestation not found"
          },
          "503": {
            "description": "Database or RPC unavailable"
          }
        },
        "tags": [
          "attestations"
        ]
      }
    }
  },

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "mocha",
      "chai",
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "sdk/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}